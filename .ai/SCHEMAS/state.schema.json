{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai/state.schema.json",
  "title": "Persistent multi-agent state",
  "type": "object",
  "required": [
    "protocol_version", "revision", "task_id", "task_file", "workflow", "state",
    "previous_state", "completed_roles", "completed_steps", "active_assignments",
    "next_role", "iteration", "max_iterations", "last_role", "last_relevant_commit",
    "reason", "summary", "blocked", "updated_at"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"const": "1.0"},
    "revision": {"type": "integer", "minimum": 0},
    "task_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "task_file": {"type": ["string", "null"]},
    "workflow": {"type": ["string", "null"], "enum": [null, "auto", "cleanup", "feature", "bugfix", "refactor", "security"]},
    "state": {"type": "string"},
    "previous_state": {"type": ["string", "null"]},
    "completed_roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
    "completed_steps": {"type": "array", "items": {"type": "string"}},
    "active_assignments": {"type": "array", "items": {"$ref": "#/$defs/activeAssignment"}},
    "next_role": {"anyOf": [{"$ref": "#/$defs/role"}, {"type": "null"}]},
    "iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 20},
    "last_role": {"anyOf": [{"$ref": "#/$defs/role"}, {"type": "null"}]},
    "last_relevant_commit": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "blocked": {
      "type": ["object", "null"],
      "properties": {
        "reason": {"type": "string"},
        "requested_action": {"type": ["string", "null"]}
      },
      "required": ["reason", "requested_action"]
    },
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "role": {"enum": ["orchestrator", "analyzer", "worker", "reviewer", "tester"]},
    "assignment": {
      "type": "object",
      "required": ["id", "role", "scope", "instructions", "acceptance_criteria"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "role": {"$ref": "#/$defs/role"},
        "scope": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "activeAssignment": {
      "allOf": [
        {"$ref": "#/$defs/assignment"},
        {"type": "object", "required": ["status"], "properties": {"status": {"const": "pending"}}}
      ]
    }
  }
}
