{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai/decision.schema.json",
  "title": "Orchestrator decision",
  "type": "object",
  "required": [
    "protocol_version", "decision_id", "task_id", "based_on_revision", "workflow",
    "state", "assignments", "iteration", "reason", "summary", "expected_outcome",
    "mark_steps_completed", "created_at"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"const": "1.0"},
    "decision_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "based_on_revision": {"type": "integer", "minimum": 0},
    "workflow": {"type": ["string", "null"]},
    "state": {"type": "string"},
    "assignments": {"type": "array", "items": {"$ref": "state.schema.json#/$defs/assignment"}},
    "iteration": {"type": "integer", "minimum": 0},
    "reason": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "expected_outcome": {"type": ["string", "null"]},
    "mark_steps_completed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "kind": {"type": "string"},
    "applied_revision": {"type": "integer"}
  }
}
